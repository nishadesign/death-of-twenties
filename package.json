{
  "name": "death-of-my-20s",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "node --import tsx --test tests/*.test.ts",
    "preview": "vite preview --host 0.0.0.0",
    "build:pages": "tsc -b && vite build --mode github-pages",
    "deploy": "npm test && npm run build:pages && gh-pages -d dist --nojekyll"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.2.8",
    "@fontsource/dm-sans": "^5.2.8",
    "@tailwindcss/vite": "^4.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "gh-pages": "^6.3.0",
    "jsdom": "^31.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.0"
  }
}
